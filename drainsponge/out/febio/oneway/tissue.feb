				<surface_load name="film_load_out8" surface="TissueBottom" type="pressure">
					<pressure lc="16" type="map">P7</pressure>
					<symmetric_stiffness>0</symmetric_stiffness>
					<linear>0</linear>
				</surface_load>
			</Loads>
		</step>
		<step id="9" name="window9">
			<Control>
				<analysis>TRANSIENT</analysis>
				<time_steps>6</time_steps>
				<step_size>490.484</step_size>
				<plot_level>PLOT_MUST_POINTS</plot_level>
				<output_level>OUTPUT_MUST_POINTS</output_level>
				<time_stepper type="default">
					<max_retries>12</max_retries>
					<opt_iter>12</opt_iter>
					<dtmin>0.029429</dtmin>
					<dtmax>490.484</dtmax>
					<aggressiveness>0</aggressiveness>
					<cutback>0.5</cutback>
				</time_stepper>
				<solver type="biphasic">
					<symmetric_stiffness>non-symmetric</symmetric_stiffness>
					<max_refs>30</max_refs>
					<diverge_reform>1</diverge_reform>
					<reform_each_time_step>1</reform_each_time_step>
					<dtol>0.001</dtol>
					<etol>0.01</etol>
					<rtol>0</rtol>
					<ptol>0.01</ptol>
					<lstol>0.9</lstol>
					<ls_check_jacobians>1</ls_check_jacobians>
					<qn_method type="BROYDEN"/>
				</solver>
			</Control>
			<Boundary>
				<bc name="film_p9" node_set="Bottom" type="prescribed fluid pressure">
					<value lc="17" type="map">dP9</value>
					<relative>1</relative>
				</bc>
			</Boundary>
			<Loads>
				<surface_load name="film_load_in9" surface="TissueBottom" type="pressure">
					<pressure lc="17" type="map">P9</pressure>
					<symmetric_stiffness>0</symmetric_stiffness>
					<linear>0</linear>
				</surface_load>
				<surface_load name="film_load_out9" surface="TissueBottom" type="pressure">
					<pressure lc="18" type="map">P8</pressure>
					<symmetric_stiffness>0</symmetric_stiffness>
					<linear>0</linear>
				</surface_load>
			</Loads>
		</step>
	</Step>
