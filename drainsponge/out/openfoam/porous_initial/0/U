\*---------------------------------------------------------------------------*/
FoamFile
{
    format      ascii;
    class       volVectorField;
    object      U;
}
dimensions      [0 1 -1 0 0 0 0];
internalField   uniform (0 0 0);
boundaryField
{
outlet
{
        type            pressureInletOutletVelocity;
        value           uniform (0 0 0);
}
film_edge
{
        type            pressureInletOutletVelocity;
        value           uniform (0 0 0);
}
tissue_top
{
        type            pressureInletOutletVelocity;
        value           uniform (0 0 0);
}
tissue_side
{
        type            pressureInletOutletVelocity;
        value           uniform (0 0 0);
}
drain_skin
{
        type            noSlip;
}
hole_wall
{
        type            noSlip;
}
wall_under
{
        type            noSlip;
}
channel_walls
{
        type            noSlip;
}
}
