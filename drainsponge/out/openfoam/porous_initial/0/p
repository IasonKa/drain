/*--------------------------------*- C++ -*----------------------------------*\
  drainsponge: single hole + sponge tissue
\*---------------------------------------------------------------------------*/
FoamFile
{
    format      ascii;
    class       volScalarField;
    object      p;
}
dimensions      [0 2 -2 0 0 0 0];
internalField   uniform 0;
boundaryField
{
outlet
{
        type            fixedValue;
        value           uniform -4.9019608;
}
film_edge
{
        type            totalPressure;
        p0              uniform 0;
        value           uniform 0;
}
tissue_top
{
        type            fixedValue;
        value           uniform 0;
}
tissue_side
{
        type            fixedValue;
        value           uniform 0;
}
drain_skin
{
        type            zeroGradient;
}
hole_wall
{
        type            zeroGradient;
}
wall_under
{
        type            zeroGradient;
}
channel_walls
{
        type            zeroGradient;
}
}
