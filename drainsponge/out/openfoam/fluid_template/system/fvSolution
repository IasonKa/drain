/*--------------------------------*- C++ -*----------------------------------*\
  drainsponge: single hole + sponge tissue
\*---------------------------------------------------------------------------*/
FoamFile
{
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
solvers
{
    p
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-9;
        relTol          0.05;
    }
    "(U|Phi)"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-10;
        relTol          0.1;
    }
}
SIMPLE
{
    nNonOrthogonalCorrectors 1;
    consistent      yes;
    residualControl { p 1e-6; U 1e-7; }
}
relaxationFactors
{
    equations { U 0.9; ".*" 0.9; }
    fields    { p 0.7; }
}
