# solver input meshes: regenerate with flow/make_flow_case.py
flow/runs/*/flow.mdpa
# superseded or failed trial runs (no results)
flow/runs/prelim/
flow/runs/test/
flow/runs/tip/
flow/runs/mid/
flow/runs/conn/
__pycache__/
*.time
# sweep meshes: regenerate with make_flow_case.py blocked --s <mm> [--d <mm>]
flow/runs/s[0-9]*/mesh.npz
flow/runs/d2s*/mesh.npz
